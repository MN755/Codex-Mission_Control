{
  "name": "codex-mission-control-dashboard",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "tsc --project tsconfig.json --noEmit && vite build --config vite.config.mjs",
