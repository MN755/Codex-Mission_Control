{
  "catalog_version": "0.3.0",
  "kind": "mission-control-resource-catalog",
  "implementation_status": "implemented_with_safe_summaries",
  "safety_defaults": {
    "summary_only": true,
    "runs_commands": false,
    "shows_raw_logs": false,
    "redact_secrets": true
  },
  "resources": [
    {
      "uri_template": "mission-control://projects/{project_id}/orchestrations/{orchestration_id}/status",
      "title": "Orchestration status",
      "summary": "Compact bridge-safe orchestration status with phase, blockers, pending decisions, and handoff readiness.",
      "support_status": "implemented",
      "source_hint": {
        "rest_endpoints": [
          "/api/orchestrations/{orchestration_id}/status"
        ]
      },
      "default_fields": [
        "orchestration_id",
        "project_id",
        "project_name",
        "orchestration_status",
        "current_phase",
        "manager_status",
        "pending_decisions_count",
        "current_blockers",
        "next_expected_action",
        "handoff_readiness"
      ],
      "redaction": {
        "omit_fields": [
          "bridge_token",
          "secret_headers",
          "raw_event_stream",
          "raw_log",
          "stack_trace"
        ],
        "notes": "Return compact orchestration state only. Do not expose raw traces or bridge secrets."
      }
    },
    {
      "uri_template": "mission-control://projects/{project_id}/orchestrations/{orchestration_id}/events",
      "title": "Orchestration events",
      "summary": "Recent orchestration events summarized for Codex chat without raw log streaming.",
      "support_status": "implemented",
      "source_hint": {
        "rest_endpoints": [
          "/api/orchestrations/{orchestration_id}/events"
        ]
      },
      "default_fields": [
        "orchestration_id",
        "event_count",
        "latest_event_at",
        "recent_events"
      ],
      "redaction": {
        "omit_fields": [
          "raw_log",
          "stack_trace",
          "secret_values",
          "full_payload"
        ],
        "notes": "Return the most recent safe events with short payload summaries only."
      }
    },
    {
      "uri_template": "mission-control://projects/{project_id}/status",
      "title": "Project status",
      "summary": "High-signal project summary combining project state, active orchestration state, and next checkpoint.",
      "support_status": "implemented",
      "source_hint": {
        "rest_endpoints": [
          "/api/projects/{project_id}",
          "/api/projects/{project_id}/orchestrations/active",
          "/api/orchestrations/{orchestration_id}/status"
        ]
      },
      "default_fields": [
        "project_id",
        "project_name",
        "project_status",
        "orchestration_status",
        "manager_status",
        "current_phase",
        "next_expected_action",
        "handoff_readiness"
      ],
      "redaction": {
        "omit_fields": [
          "api_key",
          "token",
          "secret",
          "authorization",
          "raw_command",
          "raw_log"
        ],
        "notes": "Expose status labels and next actions, not raw execution output."
      }
    },
    {
      "uri_template": "mission-control://projects/{project_id}/agents",
      "title": "Project agents",
      "summary": "Compact worker roster summary with agent role, state, and current assignment hints.",
      "support_status": "implemented",
      "source_hint": {
        "rest_endpoints": [
          "/api/projects/{project_id}/agents"
        ]
      },
      "default_fields": [
        "project_id",
        "agent_count",
        "agents"
      ],
      "redaction": {
        "omit_fields": [
          "full_transcript",
          "provider_token",
          "raw_log",
          "command_output"
        ],
        "notes": "Return short per-agent summaries instead of transcripts."
      }
    },
    {
      "uri_template": "mission-control://projects/{project_id}/pending-decisions",
      "title": "Pending decisions",
      "summary": "Unified queue of approvals, manager questions, and orchestration decisions that need user input.",
      "support_status": "implemented",
      "source_hint": {
        "rest_endpoints": [
          "/api/orchestrations/{orchestration_id}/pending-decisions",
