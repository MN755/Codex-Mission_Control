        "project_id",
        "decision_count",
        "decisions"
      ],
      "redaction": {
        "omit_fields": [
          "secret_args",
          "environment_values",
          "raw_command",
          "raw_log"
        ],
        "notes": "Return title, reason, risk, and options. Strip sensitive payload details."
