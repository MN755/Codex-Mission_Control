    "mission-control://projects/{project_id}/decision-ledger",
    "mission-control://projects/{project_id}/path-locks"
  ],
  "mcp": {
    "example_config": "./mcp/mission-control-mcp.example.json",
    "resources_catalog": "./mcp/resources.json",
    "prompts_catalog": "./mcp/prompts.json",
    "chat_templates_dir": "./templates"
  },
  "claude_code": {
    "manifest": "./.claude-plugin/plugin.json",
    "commands": "./commands/",
    "agents": "./agents/",
    "primary_commands": [
